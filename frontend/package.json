{
  "name": "lovelace-blackout-card",
  "version": "0.1.4",
  "description": "Home Assistant Lovelace cards for planned and emergency power outages from the Blackout integration",
  "type": "module",
  "license": "MIT",
  "author": "Igor Ognichenko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RobinCK/lovelace-blackout-card.git"
  },
  "keywords": [
    "home-assistant",
    "lovelace",
    "custom-card",
    "hacs",
    "power-outage",
    "blackout",
    "ukraine"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "@rollup/plugin-typescript": "^12.3.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "rollup": "^4.68.2",
    "tslib": "^2.9.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
